# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's execution environment and not part of the codebase.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're building something that should be installed in a variety of environments,
#   Python sub-dependencies can cause installations to fail.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains specific versions of dependencies
#   and may or may not be committed.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains specific versions of dependencies
#   and may or may not be committed.
# .pdm-python.map
# .pdm-build/

